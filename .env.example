# Supabase (Readly project hrlpidapontbnrvmrqzw, eu-central-1).
# Anon key only. Never put a service_role key in the frontend.
# Leave the anon key empty for the offline demo (localStorage + PIN 1234).
# When both values are set, a parent can sign in and sync under RLS.
VITE_SUPABASE_URL=https://hrlpidapontbnrvmrqzw.supabase.co
VITE_SUPABASE_ANON_KEY=

# Uncomment to stay on this device even if an anon key is filled in.
# VITE_READLY_CLOUD=0

# Optional separate LLM proxy. Coach LIVE uses the `coach` edge function
# when URL + anon key are set, and falls back to DEMO if the call fails.
# VITE_READLY_AI_URL=
